<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.student_attendance_system.FirstFragment"
        android:label="First Fragment"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.student_attendance_system.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>

    <fragment
        android:id="@+id/homePage"
        tools:layout="@layout/content_main"
        android:label="Home">
        <action
            android:id="@+id/homePageToStudentPage"
            app:destination="@+id/studentPage"/>
    </fragment>
    <fragment
        android:id="@+id/studentPage"
        tools:layout="@layout/student_page"
        android:label="Student">
        <action
            android:id="@+id/studentPageToHomePage"
            />
    </fragment>

</navigation>